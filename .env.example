# Environment Variables for LLM Genetics Assistant
# Copy this file to .env and fill in your actual API keys

# DeepSeek API Key (required for LLM analysis)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Grok (xAI) API Key (required for Review Agent)
GROK_API_KEY=xai-your-grok-api-key-here

# Tavily API Key (required for web search)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# PubMed Email (optional, for NCBI Entrez API)
PUBMED_EMAIL=your.email@example.com
